# Lokale Runtime- und Review-Konfiguration fuer den Dashboard-Lauf auf diesem PC.
# Datei als `.env.local` anlegen und echte Werte eintragen.

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_HIDDEN_RECORDS_TABLE=dashboard_hidden_records

LLM_ENABLED=true
LLM_PROVIDER=minimax
LLM_API_KEY=
LLM_MODEL=MiniMax-M2.5
LLM_BASE_URL=https://api.minimax.io
LLM_TIMEOUT_MS=30000
LLM_MAX_RECORDS=0
